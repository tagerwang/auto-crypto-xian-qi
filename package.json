{
  "name": "spot-futures-arbitrage",
  "version": "1.0.0",
  "description": "币安现期费率套利系统 - 现货做多+合约做空的市场中性策略",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arbitrage": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "binance",
    "arbitrage",
    "funding-rate",
    "spot-futures",
    "cryptocurrency",
    "trading-bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.34.1",
    "fastify": "^4.28.1",
    "mysql2": "^3.11.3",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "yaml": "^2.5.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
